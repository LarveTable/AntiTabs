{
  "manifest_version": 3,
  "name": "AntiTabs",
  "version": "0.1.14",
  "description": "Toggle protection against unwanted new tabs on the active website.",
  "browser_specific_settings": {
    "safari": { "strict_min_version": "18.4" }
  },
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/unactive-16.png",
    "32": "icons/unactive-32.png",
    "48": "icons/unactive-48.png",
    "128": "icons/unactive-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AntiTabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/unactive-16.png",
      "32": "icons/unactive-32.png",
      "48": "icons/unactive-48.png",
      "128": "icons/unactive-128.png"
    }
  }
}
